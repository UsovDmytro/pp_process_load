<!--                <pivot display_quantity="1">-->
<!--                    <field name="state" type="col"/>-->
<!--                    <field name="visit_datetime" interval="month" type="col"/>-->
<!--                    <field name="doctor_id" type="row"/>-->
<!--                </pivot>-->
<!--            </field>-->
<!--        </record>-->

        <record id="pl_work_assignment_search" model="ir.ui.view">
            <field name="name">pl.work.assignment.search (pl_work_assignment)</field>
            <field name="model">pl.work.assignment</field>
            <field name="arch" type="xml">
                <search string="Filters">
                    <group expand="0" string="Group By">
                        <filter name="foreman_id" context="{'group_by':'foreman_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_pl_work_assignment_window" model="ir.actions.act_window">
            <field name="name">Work assignment</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pl.work.assignment</field>
            <field name="view_mode">calendar,tree,form,pivot</field>
        </record>

        <menuitem id="pl_menu_work_assignment"
                  action="action_pl_work_assignment_window"
                  parent="pl_main_menu"
                  name="Work assignment" sequence="100"/>

</odoo>

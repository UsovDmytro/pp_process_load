<odoo>
        <record id="pl_work_assignment_tree" model="ir.ui.view">
            <field name="name">pl.work.assignment.tree ()</field>
            <field name="model">pl.work.assignment</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="foreman_id"/>
                    <field name="stage_id"/>
                    <field name="work_start_datetime" widget="datetime"/>
                    <field name="work_finish_datetime" widget="datetime"/>
                    <field name="state"/>
                    <field name="order_product_id"/>
                </tree>
            </field>
        </record>

        <record id="pl_work_assignment_form" model="ir.ui.view">
            <field name="name">pl.work.assignment.form ()</field>
            <field name="model">pl.work.assignment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" options="{'clickable': readonly_form}"/>
                    </header>
                        <group>
                            <group>
                                <field name="foreman_id"/>
                                <field name="stage_id"/>
                                <field name="process_id" readonly="1"/>
                                <field name="work_start_datetime" widget="datetime"/>
                                <field name="work_finish_datetime" widget="datetime"/>
                            </group>
                            <group>
                                <field name="order_product_id"/>
                                <field name="client_id" readonly="1"/>
                                <field name="order_id" readonly="1"/>
                                <field name="product_id" readonly="1"/>
                            </group>
                        </group>
                </form>
            </field>
        </record>

        <record id="pl_work_assignment_calendar" model="ir.ui.view">
            <field name="name">pl.work.assignment.calendar ()</field>
            <field name="model">pl.work.assignment</field>
            <field name="priority" eval="10"/>
            <field name="arch" type="xml">
                <calendar mode="month"
                          date_start="work_start_datetime"
                          date_stop="work_finish_datetime"
                          color="foreman_id">
                    <field name="foreman_id" filters="1"/>
                    <field name="client_id" filters="1"/>
                    <field name="order_id" filters="1"/>
                    <field name="product_id" filters="1"/>
                    <field name="process_id" filters="1"/>
                </calendar>
            </field>
        </record>

<!--        <record id="pl_work_assignment_pivot" model="ir.ui.view">-->
<!--            <field name="name">pl.work.assignment.pivot (pl_work_assignment)</field>-->
<!--            <field name="model">pl.work.assignment</field>-->

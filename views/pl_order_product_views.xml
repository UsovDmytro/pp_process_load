<odoo>
        <record id="pl_order_product_tree" model="ir.ui.view">
            <field name="name">pl.order.product.tree ()</field>
            <field name="model">pl.order.product</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="client_order_id"/>
                </tree>
            </field>
        </record>

        <record id="pl_order_product_form" model="ir.ui.view">
            <field name="name">pl.order.product.form ()</field>
            <field name="model">pl.order.product</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="client_order_id"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_pl_order_product_window" model="ir.actions.act_window">
            <field name="name">Order product</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pl.order.product</field>
            <field name="view_mode">tree,form</field>
        </record>

<!--        <menuitem id="pl_menu_order_product"-->

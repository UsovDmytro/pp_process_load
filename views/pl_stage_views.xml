<odoo>
        <record id="pl_stage_tree" model="ir.ui.view">
            <field name="name">pl.stage.tree ()</field>
            <field name="model">pl.stage</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="pl_process"/>
                </tree>
            </field>
        </record>

        <record id="pl_stage_form" model="ir.ui.view">
            <field name="name">pl.stage.form ()</field>
            <field name="model">pl.stage</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                        <field name="pl_process"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_pl_stage_window" model="ir.actions.act_window">
            <field name="name">Stage</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pl.stage</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="pl_menu_stage"
                  action="action_pl_stage_window"
                  parent="pl_main_menu"
                  name="Stage" sequence="400"/>

</odoo>

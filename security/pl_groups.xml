<odoo>
    <data noupdate="1">

        <record id="category_pl" model="ir.module.category">
            <field name="name">Process load</field>
            <field name="description">User access levels for the Process load</field>
            <field name="sequence">1</field>
        </record>

        <record id="group_pl_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="category_pl"/>
            <field name="comment">User</field>
        </record>

        <record id="group_pl_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="category_pl"/>
            <field name="implied_ids" eval="[(4, ref('group_pl_user'))]"/>
            <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
            <field name="comment">Administrators of the Process load (full rights)</field>
        </record>

    </data>
</odoo>
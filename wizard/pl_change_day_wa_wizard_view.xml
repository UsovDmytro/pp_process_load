<odoo>
    <record id="pl_change_day_wa_wizard" model="ir.ui.view">
        <field name="name">pl.change.day.wa.wizard.form</field>
        <field name="model">pl.change.day.wa.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="foreman_id"/>
                        <field name="client_order_id"/>
                        <field name="product_id"/>
                        <field name="days_change"/>
                    </group>
                    <notebook>
                        <page name="page_wa_ids" string="Розподіл робіт">
                            <field name="wa_ids" readonly="True" mode="kanban"/>
                        </page>
                    </notebook>

                </group>
                <footer>
                    <button name="change_day_in_wa" type="object" string="Change days" class="btn-primary" />
                    <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="pl_change_day_wa_wizard_action" model="ir.actions.act_window">
        <field name="name">Change days</field>
        <field name="res_model">pl.change.day.wa.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="model_pl_work_assignment"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">tree,form</field>
        <field name="target">new</field>
    </record>
</odoo>